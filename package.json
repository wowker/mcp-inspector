{
  "name": "dsers-mcp-inspector",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "dsers-inspector": "bin/dsers-inspector.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "start": "node bin/dsers-inspector.mjs",
    "build": "node scripts/clean-dist.mjs && vite build && tsup && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@hono/node-server": "1.19.14",
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.10.0",
    "hono": "4.12.12",
    "open": "10.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "jsdom": "27.4.0",
    "tsup": "8.3.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "3.2.4"
  }
}
