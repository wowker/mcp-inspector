{
  "name": "@wuwei0215/mcp-inspector",
  "version": "2.0.3",
  "type": "module",
  "bin": {
    "mcp-inspector": "bin/mcp-inspector.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "start": "node bin/mcp-inspector.mjs",
    "build": "node scripts/clean-dist.mjs && vite build && tsup && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:release": "vitest run --maxWorkers=1",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run test:release && npm run test:e2e",
    "verify:release-artifacts": "npm run build && node scripts/check-release-artifacts.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/client": "2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@primer/css": "^22.3.0",
    "@primer/primitives": "^11.10.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.10.0",
    "hono": "4.13.4",
    "i18next": "^26.4.0",
    "open": "10.2.0",
    "quickjs-emscripten": "0.32.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.12",
    "react-json-view-lite": "^2.5.0",
    "sonner": "2.0.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "jsdom": "27.4.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
